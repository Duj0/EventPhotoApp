<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventPhotoApp.Pages.PhotosPage"
             BackgroundColor="#14141F"
             Title="Gallery">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="Gallery" 
                       FontSize="26" 
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="Everyone's photos, in one place"
                       FontSize="13"
                       TextColor="#8A8A9E"/>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#2E2E42"
                    StrokeThickness="1"
                    BackgroundColor="#1E1E2E"
                    Padding="16,12">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Key" FontSize="18" VerticalOptions="Center"/>
                    <Label x:Name="CodeLabel" 
                           TextColor="#C4B5FD"
                           FontAttributes="Bold"
                           FontSize="15"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <Button Text="Take a Photo" 
                    Clicked="OnTakePhotoClicked"
                    BackgroundColor="#7C4DFF"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Import"
                        Clicked="OnPickPhotoClicked"
                        BackgroundColor="#1E1E2E"
                        BorderColor="#2E2E42"
                        BorderWidth="1"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="46"
                        FontSize="14"/>
                <Button Grid.Column="1"
                        Text="⬇ Export ZIP"
                        Clicked="OnDownloadAsZipClicked"
                        BackgroundColor="#1E1E2E"
                        BorderColor="#2E2E42"
                        BorderWidth="1"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="46"
                        FontSize="14"/>
            </Grid>

            <Label Text="PHOTOS" FontSize="12" TextColor="#8A8A9E" Margin="4,10,0,0"/>
            <CollectionView x:Name="PhotosCollection">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0">
                            <Image Source="{Binding .}" 
                                   HeightRequest="150"
                                   Aspect="AspectFill">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPhotoTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Leave Event" 
                    Clicked="OnLeaveEventClicked"
                    BackgroundColor="Transparent"
                    TextColor="#EF4444"
                    FontSize="14"
                    Margin="0,10,0,0"/>

            <Button Text="Notify Guests to download images"
                Clicked="OnNotifyGuestsClicked"
                BackgroundColor="#1E1E2E"
                BorderColor="#2E2E42"
                BorderWidth="1"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="46"
                FontSize="14"
                Margin="0,5"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>