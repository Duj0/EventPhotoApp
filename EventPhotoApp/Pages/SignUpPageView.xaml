<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EventPhotoApp.Pages.SignUpPageView"
    BackgroundColor="#14141F"
    Title="Sign Up">
    <ScrollView>
        <VerticalStackLayout Padding="32,0" Spacing="0" VerticalOptions="Center">

            <Image Source="logo.png" 
                   HeightRequest="80" 
                   HorizontalOptions="Center"
                   Margin="0,0,0,16"/>

            <Label Text="Create your account" 
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>
            <Label Text="Start sharing moments with EventSnap"
                   FontSize="14"
                   TextColor="#8A8A9E"
                   HorizontalTextAlignment="Center"
                   Margin="0,4,0,32"/>

            <Label Text="EMAIL" FontSize="11" TextColor="#8A8A9E" Margin="4,0,0,6"/>
            <Border StrokeShape="RoundRectangle 12" 
                    Stroke="#2E2E42" 
                    StrokeThickness="1"
                    BackgroundColor="#1E1E2E"
                    Padding="16,2"
                    Margin="0,0,0,18">
                <Entry Text="{Binding Email}"
                       Placeholder="you@example.com"
                       PlaceholderColor="#5A5A70"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       Keyboard="Email"
                       HeightRequest="48"/>
            </Border>

            <Label Text="PASSWORD" FontSize="11" TextColor="#8A8A9E" Margin="4,0,0,6"/>
            <Border StrokeShape="RoundRectangle 12" 
                    Stroke="#2E2E42" 
                    StrokeThickness="1"
                    BackgroundColor="#1E1E2E"
                    Padding="16,2"
                    Margin="0,0,0,28">
                <Entry Text="{Binding Password}"
                       Placeholder="At least 6 characters"
                       PlaceholderColor="#5A5A70"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       IsPassword="True"
                       HeightRequest="48"/>
            </Border>

            <Button Command="{Binding SignUpCommand}" 
                    Text="Create Account"
                    FontAttributes="Bold"
                    BackgroundColor="#7C4DFF"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52"/>

            <Button Command="{Binding NavigateSignInCommand}" 
                    Text="Already have an account?  Sign In"
                    BackgroundColor="Transparent"
                    TextColor="#A78BFA"
                    FontSize="14"
                    Margin="0,16,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>