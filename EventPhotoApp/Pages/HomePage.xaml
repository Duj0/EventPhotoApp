<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EventPhotoApp.Pages.HomePage"
    BackgroundColor="#14141F"
    Title="Home Page">
    <ScrollView>
        <VerticalStackLayout Padding="32,0" Spacing="0" VerticalOptions="Center">

            <Image Source="snapshotlogo.png" HeightRequest="130" HorizontalOptions="Center" Margin="0,0,0,16"/>

            <Label Text="EventSnap"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>
            <Label Text="Share your memories, together"
                   FontSize="14"
                   TextColor="#8A8A9E"
                   HorizontalTextAlignment="Center"
                   Margin="0,4,0,36"/>

            <Button Command="{Binding CreateEventCommand}" 
                    Text="Create Event" 
                    FontAttributes="Bold"
                    TextColor="White" 
                    BackgroundColor="#7C4DFF" 
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,0,0,12"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,0,0,12">
                <Button Grid.Column="0"
                        Command="{Binding PhotosPageCommand}" 
                        Text="Gallery" 
                        TextColor="White" 
                        BackgroundColor="#1E1E2E"
                        BorderColor="#2E2E42"
                        BorderWidth="1"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontSize="14"/>
                <Button Grid.Column="1"
                        Text="Join" 
                        TextColor="White" 
                        BackgroundColor="#1E1E2E"
                        BorderColor="#2E2E42"
                        BorderWidth="1"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontSize="14"
                        Command="{Binding JoinEventCommand}"/>
            </Grid>

            <BoxView HeightRequest="1" Color="#2E2E42" Margin="0,20"/>

            <Button Text="Sign Out" 
                    Command="{Binding SignOutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#6A6A80"
                    FontSize="14"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>