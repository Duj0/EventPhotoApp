<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventPhotoApp.Pages.CreateEventPage"
             BackgroundColor="#14141F"
             Title="Create Event">
    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="0">

            <Label Text="Create Event" 
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"/>
            <Label Text="Set the details, we'll handle the rest"
                   FontSize="13"
                   TextColor="#8A8A9E"
                   Margin="0,4,0,28"/>

            <Label Text="EVENT NAME" FontSize="11" TextColor="#8A8A9E" Margin="4,0,0,6"/>
            <Border StrokeShape="RoundRectangle 12" 
                    Stroke="#2E2E42" 
                    StrokeThickness="1"
                    BackgroundColor="#1E1E2E"
                    Padding="16,2"
                    Margin="0,0,0,18">
                <Entry x:Name="NameEntry"
                       TextColor="White"
                       PlaceholderColor="#5A5A70"
                       Placeholder="e.g. Sarah's Birthday Bash"
                       BackgroundColor="Transparent"
                       HeightRequest="48"/>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="DATE" FontSize="11" TextColor="#8A8A9E" Margin="4,0,0,6"/>
                    <Border StrokeShape="RoundRectangle 12" 
                            Stroke="#2E2E42" 
                            StrokeThickness="1"
                            BackgroundColor="#1E1E2E"
                            Padding="16,2"
                            Margin="0,0,0,28">
                        <DatePicker x:Name="DateEntry"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    HeightRequest="48"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="TIME" FontSize="11" TextColor="#8A8A9E" Margin="4,0,0,6"/>
                    <Border StrokeShape="RoundRectangle 12" 
                            Stroke="#2E2E42" 
                            StrokeThickness="1"
                            BackgroundColor="#1E1E2E"
                            Padding="16,2"
                            Margin="0,0,0,28">
                        <TimePicker x:Name="TimeEntry"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    HeightRequest="48"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Button Text="Create Event"
                    Clicked="OnSubmitEventClicked"
                    FontAttributes="Bold"
                    BackgroundColor="#7C4DFF"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>